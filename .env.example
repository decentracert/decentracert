# public verification works with this rpc; a private endpoint is optional
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PORT=3001

# uploads need both values; keep the upload key at least 24 characters
PINATA_JWT=
UPLOAD_KEY=

# optional, only for npm run deploy; browser deployment uses metamask
PRIVATE_KEY=
# json file with name, symbol, metadataUri and merkleRoot
EVENT_FILE=
