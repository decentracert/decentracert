{
  "name": "decentracert",
  "version": "1.0.1",
  "description": "Certificate NFT System for University Clubs & Events with Merkle-based claiming",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "demo": "npm run build && node scripts/localDemo.cjs",
    "dev": "npm run compile && concurrently -k -n \"SERVER,CLIENT\" -c \"green,blue\" \"npm run server\" \"craco start\"",
    "server": "node server.js",
    "build": "hardhat compile && craco build",
    "test": "npm run test:contracts && npm run test:ui && npm run test:server",
    "deploy": "hardhat run scripts/deploy.js --network sepolia",
    "test:contracts": "hardhat test",
    "compile": "hardhat compile",
    "test:server": "node --test test/server.test.cjs",
    "test:ui": "craco test --watchAll=false --runInBand"
  },
  "keywords": [
    "blockchain",
    "nft",
    "certificate",
    "merkle-tree",
    "ethereum"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "16.6.1",
    "ethers": "5.8.0",
    "express": "4.22.3",
    "multer": "2.4.0"
  },
  "devDependencies": {
    "@craco/craco": "7.1.0",
    "@nomicfoundation/hardhat-chai-matchers": "1.0.6",
    "@nomiclabs/hardhat-ethers": "2.2.3",
    "@openzeppelin/contracts": "4.9.6",
    "buffer": "6.0.3",
    "chai": "4.5.0",
    "concurrently": "8.2.2",
    "framer-motion": "12.23.12",
    "hardhat": "2.26.3",
    "keccak256": "1.0.6",
    "lucide-react": "0.525.0",
    "merkletreejs": "0.3.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4",
    "react-scripts": "5.0.1",
    "solc": "0.8.20",
    "webpack": "5.105.0"
  },
  "proxy": "http://localhost:3001",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "@ethersproject/providers": {
      "ws": "8.21.0"
    },
    "@tootallnate/once": "2.0.1",
    "@svgr/webpack": "6.5.1",
    "adm-zip": "0.6.1",
    "bn.js@4": "4.12.3",
    "postcss-selector-parser": "7.1.6",
    "resolve-url-loader": "5.0.0",
    "serialize-javascript": "7.0.5",
    "tmp": "0.2.7",
    "undici": "6.28.1",
    "underscore": "1.13.8",
    "uuid": "11.1.1",
    "cookie": "0.7.2",
    "webpack-dev-server": "5.2.6"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  }
}
